import type { Metadata } from "next";

const title = "How I use AI in my writing";
const description = "How I use AI when creating my blog content.";

export const metadata: Metadata = {
  title,
  description,
  alternates: { canonical: "/ai-disclosure" },
  openGraph: { title, description, url: "/ai-disclosure" },
};

export default function Page() {
  return (
    <section>
      <h1 className="mb-8 text-2xl font-semibold tracking-tight">{title}</h1>
      <div className="prose">
        <p>
          I generally try to limit my use of AI and create my blog content myself. I view AI as a support tool rather than a replacement for human judgment or expertise.

          When I do use AI, it is primarily to help edit my writing - for example, improving grammar and clarity or suggesting alternative phrasing.
          Occasionally, I also use it to help draft portions of a post based on my own ideas and guidance.
          
          In all cases,  I personally review and verify everything before publication.
        </p>
      </div>
    </section>
  );
}
