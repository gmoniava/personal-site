import type { Metadata } from "next";

const title = "How I use AI in my writing";
const description = "How I use AI when creating my blog content.";

export const metadata: Metadata = {
  title,
  description,
  alternates: { canonical: "/ai-disclosure" },
  openGraph: { title, description, url: "/ai-disclosure" },
};

export default function Page() {
  return (
    <section>
      <h1 className="mb-8 text-2xl font-semibold tracking-tight">{title}</h1>
      <div className="prose">
        <p>
          I generally create my blog content myself. I may use AI tools to help edit my content (for example, to improve grammar and clarity or 
          suggest alternative phrasing or framing) and draft parts of my posts based on my ideas or guidance. I personally review and verify
          everything before publication.
        </p>
      </div>
    </section>
  );
}
