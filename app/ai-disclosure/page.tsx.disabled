import type { Metadata } from "next";

const title = "How I use AI in my writing";
const description = "How I use AI when creating my blog content.";

export const metadata: Metadata = {
  title,
  description,
  alternates: { canonical: "/ai-disclosure" },
  openGraph: { title, description, url: "/ai-disclosure" },
};

export default function Page() {
  return (
    <section>
      <h1 className="mb-8 text-2xl font-semibold tracking-tight">{title}</h1>
      <div className="prose">
        <p>
          I generally create my blog content myself. I may use AI tools to edit my content (for example, grammar and
          language editing, or suggesting alternative phrasing or framing) and to help with drafting parts of my posts
          based on my ideas or guidance. I try to use AI sparingly for drafting. I personally review and verify
          everything before publication.
        </p>
        <p>
          In rare cases, such as my <em>SQL Explained Through JavaScript</em> series, I used AI more extensively for
          drafting because I was not very familair with SQL.
        </p>
      </div>
    </section>
  );
}
