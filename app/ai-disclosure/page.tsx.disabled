import type { Metadata } from "next";

const title = "How I use AI in my writing";
const description = "How I use AI when creating my blog content.";

export const metadata: Metadata = {
  title,
  description,
  alternates: { canonical: "/ai-disclosure" },
  openGraph: { title, description, url: "/ai-disclosure" },
};

export default function Page() {
  return (
    <section>
      <h1 className="mb-8 text-2xl font-semibold tracking-tight">{title}</h1>
      <div className="prose">
        <p>
          In general I try to limit my use of AI and I view AI as a support tool rather than something that should
          replace human judgement or expertise. When I do use AI, I use it in the following ways:
        </p>
        <ul>
          <li>help edit my writing (for example, improving grammar and clarity or suggesting alternative phrasing).</li>
          <li>help draft portions of a post based on my ideas and guidance.</li>
        </ul>
        <p>I personally review and verify everything before publication.</p>
      </div>
    </section>
  );
}
