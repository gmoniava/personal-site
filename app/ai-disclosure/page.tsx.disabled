import type { Metadata } from "next";

const title = "How I use AI in my writing";
const description = "How I use AI when creating my blog content.";

export const metadata: Metadata = {
  title,
  description,
  alternates: { canonical: "/ai-disclosure" },
  openGraph: { title, description, url: "/ai-disclosure" },
};

export default function Page() {
  return (
    <section>
      <h1 className="mb-8 text-2xl font-semibold tracking-tight">{title}</h1>
      <div className="prose">
        <p>
          I generally create my blog content myself. I may use AI tools to edit my content (for example, grammar and
          language editing, or suggesting alternative phrasing or framing) and to help with drafting based on my ideas or guidance
          (I try to use AI sparingly for drafting though). I personally review and verify everything before publication.
        </p>
      </div>
    </section>
  );
}
